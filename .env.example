# Jira Configuration
# Your Atlassian Cloud URL (e.g. https://your-domain.atlassian.net)
JIRA_URL=https://your-domain.atlassian.net

# The email address associated with your Jira / Atlassian account
JIRA_EMAIL=your-email@example.com

# Your Jira API Token (generate at: https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=your_jira_api_token_here
