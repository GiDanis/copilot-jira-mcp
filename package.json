  "description": "Universal MCP Server for Jira integration with GitHub Copilot CLI, Claude Desktop, Cursor, and AI assistants",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "copilot-jira-mcp": "src/cli.js",
    "jira-mcp": "src/cli.js"
  },
  "scripts": {
