  "repository": {
    "type": "git",
    "url": "git+https://github.com/GiDanis/copilot-jira-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/GiDanis/copilot-jira-mcp/issues"
  },
  "homepage": "https://github.com/GiDanis/copilot-jira-mcp#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "dotenv": "^18.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "eslint": "^8.56.0"
  },
  "files": [
    "src/",
